# Copia este fichero a .env y ajusta los valores. No subas .env al repositorio.

# Modo de autenticación: fake (sin Spotify, para desarrollo y E2E) o spotify.
# El servidor se niega a arrancar con fake si PUBLIC_ORIGIN no es localhost ni 127.0.0.1.
AUTH_MODE=fake
# Origen del catálogo de canciones: csv (catalog/songs.csv).
CATALOG_SOURCE=csv
# Persistencia de partidas: none (en memoria) o postgres.
PERSISTENCE=none
# Contraseña de Postgres. Cámbiala fuera de tu máquina (openssl rand -hex 24). La leen docker compose y DATABASE_URL.
POSTGRES_PASSWORD=hitster
# Cadena de conexión async a Postgres (SQLAlchemy + asyncpg) para la API en el host (make dev-api).
# Dentro de Compose la API usa el host "postgres" y POSTGRES_PASSWORD, sin leer esta variable.
DATABASE_URL=postgresql+asyncpg://hitster:hitster@localhost:5432/hitster
# Client ID de la app en el dashboard de Spotify (PKCE: no hace falta client secret).
SPOTIFY_CLIENT_ID=
# Client Secret: SOLO para catalog/import_spotify.py (busca los IDs de las canciones). El login PKCE no lo usa
# y el servidor no lo lee. Nunca lo subas al repositorio.
# SPOTIFY_CLIENT_SECRET=
# URI de redirección OAuth registrada en Spotify, p. ej. https://tu-dominio/api/auth/spotify/callback.
SPOTIFY_REDIRECT_URI=
# Clave Fernet (base64 URL-safe de 32 bytes) para cifrar los tokens de Spotify en reposo.
TOKEN_ENC_KEY=
# Clave que firma los tokens de sesión (HMAC-SHA256). Obligatoria si PUBLIC_ORIGIN no es localhost.
# En local puede ir vacía: se usa una clave efímera y las sesiones mueren al reiniciar. openssl rand -hex 32
SESSION_SECRET=
# Origen público de la app, p. ej. https://tu-dominio. Se usa en CORS y en enlaces.
PUBLIC_ORIGIN=http://localhost:5173
# Token de las rutas de administración (/api/admin), 32 caracteres o más. Vacío o más corto: admin desactivado.
# Caddy no publica /api/admin; se usa desde dentro de la red de Docker.
ADMIN_TOKEN=
# Dominio que Caddy usa para TLS automático en producción. En local, localhost.
DOMAIN=localhost
